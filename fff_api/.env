FFF_API_BASE_URL=https://api-dofa.fff.fr/api
SCRAPE_INTERVAL_TIMES_IN_SECONDS=86400
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://fff_user:fff_password@localhost:5432/fff_db

# Database Credentials
POSTGRES_USER=fff_user
POSTGRES_PASSWORD=fff_password
POSTGRES_DB=fff_db

# API Security
FFF_API_KEY=secret_api_key_123

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=fff-data
MINIO_SECURE=false


# Rate Limiting
FFF_API_RATE_LIMIT=500
